{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "pages/**/*.tsx",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "vite.pages.config.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}
